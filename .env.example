# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Optional deploy-level secret that gates the sync-horoscope action.
# Set it in production (.env or deployment settings) and pass --token on sync
# calls. Leave unset in local dev to sync freely (CI, smoke tests).
# HOROSCOPE_SYNC_TOKEN=
